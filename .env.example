# Copy to `.env` locally. Never commit `.env`.
#
# Nothing in this repository requires a secret to build or run locally.
# The local AI service generates its own per-installation API token at first run
# and stores it in the OS application-data directory (see docs/architecture.md).
#
# --- apps/website (Vercel) ---
# Public, non-secret configuration only. Server-side secrets are configured in the
# Vercel project settings, never in source.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- apps/desktop (Vite dev server only) ---
# When running the React UI in a plain browser (outside Tauri) during development,
# paste the token from <app-data-dir>/local-api.token here so the UI can reach the
# local service. Tauri builds never use this variable.
# VITE_MYAI_DEV_TOKEN=
