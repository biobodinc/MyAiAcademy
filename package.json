{
  "name": "myai-academy",
  "private": true,
  "version": "0.1.0",
  "description": "MyAI Academy monorepo: desktop app, website, mobile app and shared API client.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:export": "uv run python scripts/export_openapi.py",
    "api:types": "pnpm --filter @myai/api-client run generate"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "typescript": "~7.0.2"
  }
}
