# Public configuration only. Secrets are set in the Vercel dashboard, never committed.
NEXT_PUBLIC_SITE_URL=https://myaiacademy.org

# Origin of the account server (packages/myai-server), when one is running. Leave it unset and
# the account pages say plainly that there is none rather than offering a form that cannot work.
# Setting it also adds this origin to the site's Content-Security-Policy; see next.config.ts.
# NEXT_PUBLIC_ACCOUNT_API=https://accounts.myaiacademy.org
